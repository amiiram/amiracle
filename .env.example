# App
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/amiracle

# Prisma migrations use a direct connection. For local PostgreSQL, use the
# same connection string as DATABASE_URL; use Neon's unpooled URL in production.
DATABASE_URL_UNPOOLED=postgresql://postgres:postgres@localhost:5432/amiracle?schema=public

# Authentication
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=owner@amiracle.dev
ADMIN_USERNAME=amiracle
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-16-characters
NEXTAUTH_SECRET=replace-with-a-long-random-secret
NEXTAUTH_URL=http://localhost:3000

# Optional analytics / service keys can be added here later.
